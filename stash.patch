diff --git a/Assets/Scripts/Gameplay/Mine/Blocks/MineManager.cs b/Assets/Scripts/Gameplay/Mine/Blocks/MineManager.cs
new file mode 100644
--- /dev/null	(date 1773680456668)
+++ b/Assets/Scripts/Gameplay/Mine/Blocks/MineManager.cs	(date 1773680456668)
@@ -0,0 +1,28 @@
+using UnityEngine;
+using VContainer.Unity;
+
+public class MineManager : IStartable
+{
+    private MineManagerRefs _refs;
+    private ObjectPool<Transform> _blockPool;
+    
+    
+    public MineManager(MineManagerRefs refs)
+    {
+        _refs = refs;
+        _blockPool = new ObjectPool<Transform>(
+            refs.blockPrefab, refs.transform, prewarm:_refs.mineSize * refs.mineSize * 2
+            );
+
+        for (var i = _refs.yMin; i < _refs.yMax; i += (_refs.yMax - _refs.yMin) / refs.mineSize)
+        for (var j = _refs.xMin; j < _refs.xMax; j += (_refs.xMax - _refs.xMin) / refs.mineSize)
+        {
+            var block = _blockPool.Rent();
+            block.transform.localPosition = new Vector3(i, j, 0);   
+        }
+    }
+
+    public void Start()
+    {
+    }
+}
\ No newline at end of file
